[submodule "lib/sdl"]
	path = lib/sdl
	url = https://github.com/libsdl-org/SDL.git
[submodule "lib/essencio"]
	path = lib/essencio
	url = https://github.com/bottledlactose/essencio.git
[submodule "lib/glm"]
	path = lib/glm
	url = https://github.com/g-truc/glm.git
[submodule "lib/gli"]
	path = lib/gli
	url = https://github.com/g-truc/gli.git
[submodule "lib/imgui"]
	path = lib/imgui
	url = https://github.com/ocornut/imgui.git
	branch = docking
[submodule "lib/tinyxml"]
	path = lib/tinyxml
	url = https://github.com/leethomason/tinyxml2.git
[submodule "lib/nfd"]
	path = lib/nfd
	url = https://github.com/mlabbe/nativefiledialog.git
